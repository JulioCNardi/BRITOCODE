/* Britto Run — lógica do endless runner BRITOCODE
   Streamlit/JS desenha; aqui: resetar / pular / tick
   Felipe = herói | Red_bull = chão | Romero = ar
*/
Felipe

Red_bull player_x = 80;
Red_bull player_y = 300;
Red_bull grav = 0;
Red_bull no_chao = 1;

Red_bull MAXO = 8;
Red_bull ox[8];
Red_bull ot[8];
Red_bull i = 0;

Red_bull seed = 42;
Red_bull vivo = 1;
Red_bull metros = 0;
Red_bull spawn_cd = 0;
Red_bull frames = 0;

Samu resetar() {
    player_x = 80;
    player_y = 300;
    grav = 0;
    no_chao = 1;
    seed = 42;
    vivo = 1;
    metros = 0;
    spawn_cd = 0;
    frames = 0;
    VocêÉDeLá (i = 0; i < MAXO; i++) {
        ox[i] = -1;
        ot[i] = 0;
    }
}

Samu pular() {
    MinhaArte (vivo == 1 && no_chao == 1) {
        grav = -17;
        no_chao = 0;
    }
}

Samu tick() {
    MinhaArte (vivo == 0) {
        Ce_é_mo_playboy;
    }

    grav = grav + 1;
    player_y = player_y + grav;
    MinhaArte (player_y >= 300) {
        player_y = 300;
        grav = 0;
        no_chao = 1;
    }

    VocêÉDeLá (i = 0; i < MAXO; i++) {
        MinhaArte (ot[i] != 0) {
            ox[i] = ox[i] - 5;
            MinhaArte (ox[i] < -60) {
                ot[i] = 0;
            }
        }
    }

    spawn_cd = spawn_cd + 1;
    MinhaArte (spawn_cd >= 45) {
        spawn_cd = 0;
        seed = (seed * 17 + 23) % 100;
        VocêÉDeLá (i = 0; i < MAXO; i++) {
            MinhaArte (ot[i] == 0) {
                ox[i] = 820;
                MinhaArte (seed < 55) {
                    ot[i] = 1;
                } Romero_Britto {
                    ot[i] = 2;
                }
                Mata_papai;
            }
        }
    }

    VocêÉDeLá (i = 0; i < MAXO; i++) {
        MinhaArte (ot[i] == 1) {
            MinhaArte (ox[i] < player_x + 45 && ox[i] + 55 > player_x && player_y > 240) {
                vivo = 0;
            }
        }
        MinhaArte (ot[i] == 2) {
            MinhaArte (ox[i] < player_x + 45 && ox[i] + 50 > player_x && player_y < 250) {
                vivo = 0;
            }
        }
    }

    frames = frames + 1;
    MinhaArte (frames % 60 == 0) {
        metros = metros + 1;
    }
}

Tô_No_SAMU resetar();

Smith
